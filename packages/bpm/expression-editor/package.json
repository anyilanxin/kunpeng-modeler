{
  "name": "@kunpeng/expression-editor",
  "version": "2.6.0",
  "description": "Editor for FEEL expressions.",
  "type": "module",
  "main": "./dist/index.js",
  "source": "./src/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "all": "run-s lint check-types test build",
    "test": "vitest run",
    "build": "rimraf dist && vite build",
    "build:watch": "npm run build -- -w",
    "lint": "eslint .",
    "check-types": "run-s check-types:*",
    "check-types:src": "tsc",
    "check-types:test": "tsc -p test",
    "start": "cross-env SINGLE_START=true npm run dev",
    "start:camunda": "cross-env SINGLE_START=camunda npm run dev",
    "dev": "vitest --watch",
    "prepare": "run-s build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmn-io/feel-editor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "bpmn-io",
    "feel",
    "editor"
  ],
  "author": {
    "name": "Martin Stamm",
    "url": "https://github.com/marstamm"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@bpmn-io/cm-theme": "catalog:",
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@kunpeng/expression-builtins": "workspace:*",
    "@kunpeng/expression-lint": "workspace:*",
    "@kunpeng/lang-expression": "workspace:*",
    "@lezer/highlight": "catalog:",
    "min-dom": "catalog:",
    "mitt": "catalog:"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/chai": "catalog:",
    "@types/mocha": "catalog:",
    "@types/sinon": "catalog:",
    "@types/sinon-chai": "catalog:",
    "chai": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-bpmn-io": "catalog:",
    "happy-dom": "catalog:",
    "mocha": "catalog:",
    "mocha-test-container-support": "catalog:",
    "npm-run-all2": "catalog:",
    "rimraf": "catalog:",
    "sinon": "catalog:",
    "sinon-chai": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/index.d.ts"
}
