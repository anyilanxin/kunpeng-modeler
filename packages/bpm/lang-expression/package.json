{
  "name": "@kunpeng/lang-expression",
  "version": "4.0.2",
  "description": "FEEL language support for the CodeMirror code editor",
  "scripts": {
    "all": "run-s lint build check-types test",
    "test": "vitest run",
    "dev": "vitest --watch",
    "lint": "eslint . --ext ts",
    "build": "rimraf dist && tsc --emitDeclarationOnly && vite build",
    "check-types": "tsc --noEmit",
    "prepare": "run-s build"
  },
  "keywords": [
    "editor",
    "code"
  ],
  "author": {
    "name": "Nico Rehwaldt",
    "url": "https://github.com/nikku"
  },
  "type": "module",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/language": "catalog:",
    "@kunpeng/lezer-expression": "workspace:*",
    "@lezer/common": "catalog:"
  },
  "devDependencies": {
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@types/chai": "catalog:",
    "@types/mocha": "catalog:",
    "chai": "catalog:",
    "codemirror": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-bpmn-io": "catalog:",
    "happy-dom": "catalog:",
    "min-dom": "catalog:",
    "mocha": "catalog:",
    "npm-run-all2": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/lang-feel.git"
  },
  "engines": {
    "node": ">= 20.12.0"
  },
  "files": [
    "dist"
  ]
}
