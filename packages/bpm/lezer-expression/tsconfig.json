{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2018"
    ],
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "declaration": true,
