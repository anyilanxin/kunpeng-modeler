{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "AssignmentDefinition",
  "id": "com.camunda.example.AssignmentDefinition",
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:UserTask"
  },
  "properties": [
    {
      "type": "Hidden",
      "binding": {
        "type": "kunpeng:userTask"
      }
    },
    {
      "label": "Assignee",
      "description": "Assignee for user task",
      "type": "String",
      "value": "anAssignee",
      "binding": {
        "type": "kunpeng:assignmentDefinition",
        "property": "assignee"
      }
    },
    {
      "type": "Text",
      "value": "aCandidateGroup, anotherCandidateGroup",
      "binding": {
        "type": "kunpeng:assignmentDefinition",
        "property": "candidateGroups"
      }
    },
    {
      "type": "String",
      "value": "aCandidateUser",
      "binding": {
        "type": "kunpeng:assignmentDefinition",
        "property": "candidateUsers"
      }
    }
  ]
}