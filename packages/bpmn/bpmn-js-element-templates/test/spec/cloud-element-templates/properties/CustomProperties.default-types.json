[
  {
    "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
    "name": "Rest Template",
    "id": "com.example.default-types",
    "appliesTo": [
      "bpmn:ServiceTask"
    ],
    "properties": [
      {
        "value": "foo",
        "binding": {
          "type": "property",
          "name": "name"
        }
      },
      {
        "value": "task-type",
        "binding": {
          "type": "kunpeng:taskDefinition:type"
        }
      },
      {
        "value": "header-1-value",
        "binding": {
          "type": "kunpeng:taskHeader",
          "key": "header-1-key"
        }
      },
      {
        "value": "input-1-source",
        "binding": {
          "type": "kunpeng:input",
          "name": "input-1-target"
        }
      },
      {
        "value": "output-1-target",
        "binding": {
          "type": "kunpeng:output",
          "source": "output-1-source"
        }
      },
      {
        "label": "property-1",
        "binding": {
          "type": "kunpeng:property",
          "name": "property-1-name"
        }
      }
    ]
  }
]
