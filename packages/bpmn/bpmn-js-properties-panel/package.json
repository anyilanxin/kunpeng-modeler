{
  "name": "@kunpeng/bpmn-js-properties-panel",
  "version": "2026.0.0-alpha1",
  "description": "A simple properties panel for bpmn-js",
  "files": [
    "dist"
  ],
  "scripts": {
    "all": "run-s lint test distro",
    "distro": "run-s build test:build",
    "clean": "rimraf dist",
    "build": "rimraf dist && vite build",
    "lib": "rimraf dist && vite build",
    "bundle": "rimraf dist && vite build",
    "lint": "eslint .",
    "dev": "vitest --watch",
    "test": "vitest run",
    "test:build": "mocha --reporter=spec --recursive test/distro",
    "start": "npm run start:cloud",
    "start:cloud": "cross-env SINGLE_START=cloud npm run dev",
    "start:bpmn": "cross-env SINGLE_START=bpmn npm run dev",
    "prepare": "run-s build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/bpmn-js-properties-panel"
  },
  "keywords": [
    "bpmn-io",
    "bpmn-js",
    "properties",
    "properties-panel"
  ],
  "engines": {
    "node": "*"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "umd:main": "dist/bpmn-js-properties-panel.umd.js",
  "author": {
    "name": "Nico Rehwaldt",
    "url": "https://github.com/nikku"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@kunpeng/extract-process-variables": "workspace:*",
    "array-move": "catalog:",
    "ids": "catalog:",
    "min-dash": "catalog:",
    "min-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "catalog:",
    "@bpmn-io/element-template-chooser": "catalog:",
    "@kunpeng/bpmn-js-behaviors": "workspace:*",
    "@kunpeng/bpmn-moddle": "workspace:*",
    "@kunpeng/properties-panel": "workspace:*",
    "@kunpeng/variable-resolver": "workspace:*",
    "@rollup/plugin-alias": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@testing-library/preact": "catalog:",
    "axe-core": "catalog:",
    "bpmn-js": "catalog:",
    "bpmn-js-create-append-anything": "catalog:",
    "bpmn-moddle": "catalog:",
    "chai": "catalog:",
    "cross-env": "catalog:",
    "diagram-js": "catalog:",
    "downloadjs": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-bpmn-io": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "file-drops": "catalog:",
    "happy-dom": "catalog:",
    "mocha": "catalog:",
    "mocha-test-container-support": "catalog:",
    "npm-run-all2": "catalog:",
    "rimraf": "catalog:",
    "semver": "catalog:",
    "sinon": "catalog:",
    "sinon-chai": "catalog:",
    "vite": "catalog:",
    "vite-plugin-babel": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@kunpeng/properties-panel": ">= 3.7",
    "bpmn-js": ">= 11.5",
    "camunda-bpmn-js-behaviors": ">= 0.4",
    "diagram-js": ">= 11.9"
  }
}
