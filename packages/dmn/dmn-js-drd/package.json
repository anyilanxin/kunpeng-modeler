{
  "name": "@kunpeng/dmn-js-drd",
  "version": "17.8.1",
  "description": "A decision requirements diagram view for dmn-js",
  "keywords": [
    "dmn",
    "dmn-js",
    "dmn-js-view",
    "drd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/dmn-js",
    "directory": "packages/dmn-js-drd"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "all": "run-s build test",
    "start": "cross-env SINGLE_START=modeler npm run dev",
    "start:viewer": "cross-env SINGLE_START=viewer npm run dev",
    "test": "vitest run",
    "build": "rimraf lib && vite build",
    "prepare": "run-s build",
    "dev": "vitest --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "assets",
    "lib"
  ],
  "main": "./lib/index.js",
  "dependencies": {
    "@kunpeng/dmn-js-shared": "workspace:*",
    "diagram-js": "catalog:",
    "diagram-js-direct-editing": "catalog:",
    "ids": "catalog:",
    "inherits-browser": "catalog:",
    "min-dash": "catalog:",
    "min-dom": "catalog:",
    "object-refs": "catalog:",
    "tiny-svg": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "chai": "catalog:",
    "cross-env": "catalog:",
    "dmn-font": "catalog:",
    "glob": "catalog:",
    "happy-dom": "catalog:",
    "mocha-test-container-support": "catalog:",
    "npm-run-all2": "catalog:",
    "rimraf": "catalog:",
    "sinon": "catalog:",
    "sinon-chai": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
